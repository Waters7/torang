# Nilai di bawah untuk pengembangan lokal. Di server produksi ubah sesuai komentar "Produksi:",
# lalu periksa dengan `php artisan torang:check` (lihat README › Deployment VPS).

APP_NAME=TORANG
# Produksi: APP_ENV=production
APP_ENV=local
APP_KEY=
# Produksi: APP_DEBUG=false (wajib; torang:check gagal bila masih true)
APP_DEBUG=true
# Produksi: https://torang.example.ac.id — dengan https, semua URL dipaksa HTTPS
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Produksi: LOG_STACK=daily dan LOG_LEVEL=warning (file log dirotasi, disimpan LOG_DAILY_DAYS hari)
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=torang
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi dengan HTTPS: true (cookie sesi hanya dikirim lewat HTTPS)
SESSION_SECURE_COOKIE=

# Lama konfirmasi ulang password sebelum melihat password WiFi (detik)
AUTH_PASSWORD_TIMEOUT=300

# Isi bila server berada di balik reverse proxy/CDN (mis. Cloudflare): IP proxy dipisah koma, atau *
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue: database (default) atau redis. Worker dijalankan Supervisor (deploy/supervisor/torang.conf).
QUEUE_CONNECTION=database
# Harus lebih lama dari job terlama (backup database 300 detik)
DB_QUEUE_RETRY_AFTER=360

# Produksi opsional: CACHE_STORE=redis untuk cache yang lebih ringan
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis opsional (queue/cache produksi); butuh ekstensi phpredis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=360

# Produksi: MAIL_MAILER=smtp dengan host, port 587, MAIL_SCHEME=null (STARTTLS) atau smtps,
# dan akun email kampus. Password SMTP hanya di .env server, jangan di-commit.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="helpdesk@example.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Akun super admin awal (dibuat oleh AdminUserSeeder). Ganti password setelah login pertama,
# lalu kosongkan ADMIN_PASSWORD di .env server.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Captcha Cloudflare Turnstile untuk form publik. Kunci uji lokal (selalu lolos):
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# Produksi: wajib diisi kunci asli dari dasbor Cloudflare (form publik menolak kiriman bila kosong).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Token rahasia notifikasi (jangan disimpan di database)
TELEGRAM_BOT_TOKEN=
# Gateway WhatsApp generik: driver http (POST JSON target+message) atau log (lokal)
WHATSAPP_DRIVER=http
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

# Konversi laporan UKOM ke PDF: nama perintah di PATH atau path lengkap ke soffice
LIBREOFFICE_BINARY=soffice

# Folder mysqldump/mariadb-dump; kosong bila sudah tersedia di PATH
DB_DUMP_BINARY_PATH=
# Opsional: password arsip backup privat
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
