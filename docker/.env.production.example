# Salin ke .env di server, lalu isi yang kosong. Jangan di-commit.
# APP_KEY, DB_PASSWORD, dan DB_ROOT_PASSWORD dibuat di server (lihat README › Deployment dengan Docker).

APP_NAME=TORANG
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://torang.example.ac.id

# Port localhost kontainer web, tujuan proxy Nginx host. Jangan bentrok dengan aplikasi lain di server.
WEB_PORT=8110

APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB dari compose.yaml. Port database tidak dibuka ke luar.
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=torang
DB_USERNAME=torang
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
AUTH_PASSWORD_TIMEOUT=300

# Kontainer web hanya terbuka di localhost, jadi satu-satunya proxy adalah Nginx host.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
CACHE_STORE=database

# SMTP email kampus: notifikasi dan email lupa kata sandi. Tanpa ini email hanya masuk log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="helpdesk@example.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# Kosongkan bila akun dibuat dengan torang:import-users.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Wajib di produksi: tanpa kunci ini form publik dan halaman masuk petugas menolak kiriman.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

TELEGRAM_BOT_TOKEN=
WHATSAPP_DRIVER=http
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

LIBREOFFICE_BINARY=soffice
DB_DUMP_BINARY_PATH=
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
